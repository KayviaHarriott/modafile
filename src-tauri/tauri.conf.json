{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KiloFile",
  "version": "1.0.0",
  "identifier": "com.kayviaharriott.kilofile",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "KiloFile",
        "width": 128,
        "height": 520,
        "minWidth": 128,
        "minHeight": 520,
        "maxWidth": 820,
        "maxHeight": 520,
        "resizable": false,
        "fullscreen": false,
        "center": false,
        "x": 20,
        "y": 180,
        "decorations": true,
        "transparent": true,
        "shadow": false,
        "dragDropEnabled": true,
        "alwaysOnTop": false,
        "visibleOnAllWorkspaces": false,
        "acceptFirstMouse": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 12, "y": 12 },
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/kilofile.icns"],
    "category": "Productivity",
    "shortDescription": "Private PDF compression that preserves interactions.",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
